{
  "name": "@reunion/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@reunion/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.27.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
