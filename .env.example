# ===== Runtime =====
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Ho_Chi_Minh

# ===== Database =====
DATABASE_URL=postgres://reunion:reunion@localhost:5432/reunion
DATABASE_MAX_POOL=10

# ===== Redis =====
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=reunion:

# ===== Gemini =====
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_EMBED=text-embedding-004
GEMINI_DAILY_REQUEST_BUDGET=200
GEMINI_LITE_DAILY_BUDGET=800

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Zalo =====
ZALO_ENABLED=false
ZALO_CREDENTIALS_PATH=/data/zalo/credentials.enc
ZALO_CREDENTIALS_KEY=
ZALO_ALLOWED_GROUP_IDS=

# ===== Bot config =====
BOT_DISPLAY_NAME=Trợ lý Lớp
PRIMARY_EVENT_NAME=Họp lớp 10 năm 2/9
PRIMARY_EVENT_DATE=2025-09-02T11:00:00+07:00
ORGANIZER_TELEGRAM_IDS=
ORGANIZER_ZALO_IDS=
TREASURER_USER_IDS=

# ===== Backup =====
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=30

# ===== Langfuse tracing (optional) =====
# Cloud: lấy key tại cloud.langfuse.com (free tier: 50k obs/tháng)
# Self-hosted: đổi LANGFUSE_HOST thành URL server của bạn
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
